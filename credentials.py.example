# Copy this file to credentials.py and fill in real values.
# credentials.py is gitignored -- never commit it.

# ── WiFi ──────────────────────────────────────────────────────
WIFI_SSID     = "your_wifi_ssid"
WIFI_PASSWORD = "your_wifi_password"

# ── MQTT broker ───────────────────────────────────────────────
# Address (IP or host name) of the MQTT broker of the competition server,
# and its port (1883 is the standard MQTT port). Ask the event organiser.
MQTT_BROKER   = "your-broker-address"
MQTT_PORT     = 1883
MQTT_USER     = "your-mqtt-username"
MQTT_PASSWORD = "your-mqtt-password"

# ── Competition assignment ────────────────────────────────────
# Set to the Category (Competition) DB id your robot is assigned to.
COMPETITION_ID = 1
